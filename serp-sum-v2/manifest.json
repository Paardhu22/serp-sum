{
  "name": "serp-sum-v2",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "The AI Browser OS",
  "action": {
    "default_title": "serp-sum Menu",
    "default_icon": {
      "16": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
      "32": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
      "48": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
      "128": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png"
    }
  },
  "icons": {
    "16": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
    "32": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
    "48": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png",
    "128": "Gemini_Generated_Image_v58ufcv58ufcv58u-removebg-preview.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "identity",
    "identity.email"
  ],
  "oauth2": {
    "client_id": "1003299289489-i4ifnhaqm2luubib87senqdj07fhmgcg.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.tsx"
      ]
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  }
}